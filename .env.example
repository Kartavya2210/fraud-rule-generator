# Database. Leave unset to use a local SQLite file (data/fraud.db).
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/fraud_rules

# LLM provider: ollama (local) | gemini | groq (cloud)
LLM_PROVIDER=ollama

# Ollama (local server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Google Gemini
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Generation
MAX_GENERATION_ATTEMPTS=3

# Deployment gates for back-tests
BACKTEST_MIN_PRECISION=0.30
BACKTEST_MAX_FLAG_RATE=0.02
BACKTEST_MIN_FLAGGED=5
